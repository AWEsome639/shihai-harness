2026-11-15T18:56:34.4664687Z #!/usr/bin/env python3
2026-11-15T18:56:34.4665482Z """Clash check for an IFC model: report axis-aligned bounding-box overlaps.
2026-11-15T18:56:34.4666485Z 
2026-11-15T18:56:34.4667089Z Usage:  python3 clash_check.py <model.ifc> [--tolerance-mm 2] [--limit 40]
2026-11-15T18:56:34.4667802Z 
2026-11-15T18:56:34.4668380Z A "hard clash" is two distinct elements whose axis-aligned bounding boxes overlap
2026-11-15T18:56:34.4669603Z by more than the tolerance on all three axes.  Bounding boxes are conservative -
2026-11-15T18:56:34.4671332Z a reported pair still needs a look - but a clean report is strong evidence that
2026-11-15T18:56:34.4672319Z there is no hard clash at all.
2026-11-15T18:56:34.4672793Z 
2026-11-15T18:56:34.4673351Z Runs with ifcopenshell only (no numpy, no network).  Exit code 1 when clashes are
2026-11-15T18:56:34.4674339Z found so a shell caller can gate on it.
2026-11-15T18:56:34.4675041Z """
2026-11-15T18:56:34.4675687Z import sys
2026-11-15T18:56:34.4676253Z 
2026-11-15T18:56:34.4676585Z try:
2026-11-15T18:56:34.4677161Z     import ifcopenshell
2026-11-15T18:56:34.4677840Z     import ifcopenshell.geom
2026-11-15T18:56:34.4678527Z except ImportError:
2026-11-15T18:56:34.4679319Z     sys.exit("ifcopenshell is not importable in this environment")
2026-11-15T18:56:34.4680040Z 
2026-11-15T18:56:34.4680223Z 
2026-11-15T18:56:34.4680599Z def boxes(path, tolerance):
2026-11-15T18:56:34.4681258Z     f = ifcopenshell.open(path)
2026-11-15T18:56:34.4681966Z     settings = ifcopenshell.geom.settings()
2026-11-15T18:56:34.4682764Z     settings.set(settings.USE_WORLD_COORDS, True)
2026-11-15T18:56:34.4683544Z     out = []
2026-11-15T18:56:34.4684404Z     for el in f.by_type("IfcProduct"):
2026-11-15T18:56:34.4685151Z         if not getattr(el, "Representation", None):
2026-11-15T18:56:34.4685879Z             continue
2026-11-15T18:56:34.4686779Z         try:
2026-11-15T18:56:34.4687472Z             shape = ifcopenshell.geom.create_shape(settings, el)
2026-11-15T18:56:34.4688285Z         except Exception:
2026-11-15T18:56:34.4688905Z             continue
2026-11-15T18:56:34.4689511Z         verts = shape.geometry.verts
2026-11-15T18:56:34.4690152Z         if not verts:
2026-11-15T18:56:34.4690703Z             continue
2026-11-15T18:56:34.4691473Z         xs, ys, zs = verts[0::3], verts[1::3], verts[2::3]
2026-11-15T18:56:34.4692255Z         lo = (min(xs), min(ys), min(zs))
2026-11-15T18:56:34.4692965Z         hi = (max(xs), max(ys), max(zs))
2026-11-15T18:56:34.4693687Z         if all(hi[i] - lo[i] >= 0 for i in range(3)):
2026-11-15T18:56:34.4694611Z             out.append((el.GlobalId, el.is_a(), lo, hi))
2026-11-15T18:56:34.4695411Z     return out
2026-11-15T18:56:34.4695841Z 
2026-11-15T18:56:34.4696023Z 
2026-11-15T18:56:34.4696580Z def overlap
